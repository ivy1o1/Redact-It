# RedactIt local configuration.
# Copy to .env and adjust. .env is git-ignored and must never be committed.
#
# Everything here runs on your machine. Document text and instructions are
# only ever sent to the local llama.cpp server configured below.

# ---------------------------------------------------------------- app
APP_NAME=RedactIt API
ENVIRONMENT=development
DEBUG=false
HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

# Comma-separated list or JSON array. Keep this to your own frontend origins.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------- storage
# Working directory for uploads, extracted text and generated files.
# Leave relative to resolve inside backend/, or set an absolute local path.
STORAGE_ROOT=var
SESSION_TTL_MINUTES=30
DOWNLOAD_TTL_MINUTES=15
CLEANUP_INTERVAL_SECONDS=60

MAX_UPLOAD_FILES=5
MAX_FILE_SIZE_BYTES=26214400
MAX_TOTAL_UPLOAD_BYTES=62914560
ALLOWED_EXTENSIONS=.pdf,.docx

# ---------------------------------------------------------------- local model (llama.cpp)
# VERIFIED against a running llama-server on this machine.
# The OpenAI-compatible base URL must include the /v1 suffix.
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_MODEL=gemma-3-1b-it
LLM_TIMEOUT_SECONDS=120
LLM_CONNECT_TIMEOUT_SECONDS=5
LLM_MAX_TOKENS=700
LLM_TEMPERATURE=0.0

# Only needed if you started llama-server with --api-key.
# LLM_API_KEY=

# Hard safety switches. RedactIt refuses to start if cloud fallback is enabled,
# and refuses non-loopback model hosts unless explicitly allowed.
LLM_ALLOW_CLOUD_FALLBACK=false
LLM_ALLOW_NON_LOOPBACK=false

# Use llama.cpp grammar-constrained JSON output. Requires a build with
# response_format json_schema support. Disable only if your build lacks it.
LLM_USE_JSON_SCHEMA=true
LLM_MAX_ATTEMPTS=2

# Bounded input: how much document text may be shown to the local model.
LLM_MAX_PROMPT_CHARS=6000

# ---------------------------------------------------------------- redaction
REDACTION_REPLACEMENT_TEXT=[REDACTED]
PDF_REDACT_IMAGES=true

# ---------------------------------------------------------------- logging
LOG_LEVEL=INFO
LOG_JSON=true
